{
  "manifest_version": 3,
  "name": "Prime Video Session Import",
  "version": "1.4.0",
  "description": "Imports Prime Video session from login links.",
  "incognito": "spanning",
  "permissions": ["cookies", "storage", "tabs", "webNavigation"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "*://*.amazon.in/*",
    "*://*.amazon.co.uk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["import.html", "import.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
